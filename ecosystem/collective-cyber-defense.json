  "controlFamilies": [
    {
      "id": "LEADERSHIP_PRIORITY",
      "requirement": "Treat cyber defense as an immediate leadership priority."
    },
    {
      "id": "RISK_REMEDIATION",
      "requirement": "Fix highest-risk weaknesses and verify results."
    },
    {
      "id": "LEAST_PRIVILEGE",
      "requirement": "Build and operate with least privilege."
    },
    {
      "id": "STRONG_ACCESS_CONTROL",
      "requirement": "Use strong authentication and access controls."
    },
    {
      "id": "DEFENSE_IN_DEPTH",
      "requirement": "Apply layered defenses and verified compensating controls."
    },
    {
      "id": "SECURE_SOFTWARE",
      "requirement": "Raise the security bar for purchased, built, deployed, and AI-generated code."
    },
    {
      "id": "CONTINUOUS_TESTING",
      "requirement": "Continuously test defenses against current frontier capabilities."
    },
    {
      "id": "VERIFIED_FIXES",
      "requirement": "Validate that remediation works without disrupting essential services."
    },
    {
      "id": "THREAT_INTELLIGENCE_SHARING",
      "requirement": "Share actionable intelligence, tested playbooks, and verified fixes."
    },
    {
      "id": "INCIDENT_RESPONSE",
      "requirement": "Coordinate containment, response, recovery, and learning."
    },
    {
      "id": "CRITICAL_INFRASTRUCTURE",
      "requirement": "Prioritize accessible defense for under-resourced essential services."
    },
    {
      "id": "AGENT_IDENTITY",
      "requirement": "Make agentic identities traceable and accountable."
    },
    {
      "id": "OBSERVABILITY",
      "requirement": "Provide continuous monitoring, logs, metrics, and evidence."
    },
    {
      "id": "AUTHORIZED_TESTING_DISCLOSURE",
      "requirement": "Use authorized testing, private disclosure, and evidence-backed remediation."
    },
    {
      "id": "MEASURABLE_OUTCOMES",
      "requirement": "Measure protection coverage, containment speed, and fix effectiveness."
    }
  ],
