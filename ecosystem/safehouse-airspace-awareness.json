  "sensorModalities": [
    "REMOTE_ID",
    "RADIO_FREQUENCY",
    "ACOUSTIC"
  ],
  "classificationStates": [
    "KNOWN",
    "EXPECTED",
    "UNKNOWN",
    "SUSPICIOUS"
  ],
  "decisionStates": [
    "ALLOW",
    "MONITOR",
    "ALERT",
    "ESCALATE_FOR_REVIEW",
    "BLOCK_AUTONOMOUS_ACTION"
  ],
  "pipeline": [
    "INGEST_SENSOR_OBSERVATION",
    "NORMALIZE",
    "CORRELATE",
    "FUSE_EVIDENCE",
    "BUILD_OR_UPDATE_TRACK",
    "CLASSIFY",
    "ASSESS",
    "ALERT_IF_POLICY_REQUIRES",
    "HUMAN_OR_AUTHORIZED_REVIEW",
    "ATTACH_GLASS_ONION_EVIDENCE",
    "RETURN_AUDIT_TO_BLACK_HOUSE"
  ],
  "links": [
    "SENSOR_OBSERVES_TRACK",
    "OBSERVATION_SUPPORTS_CLASSIFICATION",
    "TRACK_NEAR_PROTECTED_SITE",
    "CLASSIFICATION_SUPPORTS_ASSESSMENT",
    "ASSESSMENT_TRIGGERS_ALERT",
    "ALERT_REQUIRES_REVIEW",
