    }
  },
  "objectTypes": [
    "PROTECTED_SITE",
    "AIRSPACE_SENSOR",
    "REMOTE_ID_OBSERVATION",
    "RF_OBSERVATION",
    "ACOUSTIC_OBSERVATION",
    "SENSOR_OBSERVATION",
    "AIRCRAFT_TRACK",
    "CLASSIFICATION",
    "THREAT_ASSESSMENT",
    "AIRSPACE_ALERT",
    "OPERATOR_REVIEW",
    "SAFEHOUSE_EVIDENCE"
