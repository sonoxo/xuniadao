    "DECISION_REQUIRES_EVIDENCE",
    "SAFEHOUSE_PROTECTS_SITE",
    "GLASS_ONION_GOVERNS_DECISION"
  ],
  "evidenceRequirements": {
    "timestampRequired": true,
    "sourceSensorRequired": true,
    "locationRequiredWhenAvailable": true,
    "confidenceRequired": true,
    "classificationBasisRequired": true,
    "decisionRationaleRequired": true,
    "operatorIdentityRequiredForConsequentialReview": true,
    "provenanceRequired": true
