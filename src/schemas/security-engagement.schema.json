{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://xunia.dev/schemas/security-engagement-v1.json",
  "title": "XUNIA Security Engagement",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "engagementId", "owner", "mode", "startsAt", "endsAt", "targets", "allowedChecks", "maxRequestsPerSecond", "maxConcurrency", "destructiveAllowed", "authorizationReference"],
  "properties": {
    "schemaVersion": { "const": "xunia.security.engagement/v1" },
    "engagementId": { "type": "string", "minLength": 1 },
    "owner": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["ASSESS", "PENTEST", "SIMULATE"] },
    "startsAt": { "type": "string", "format": "date-time" },
    "endsAt": { "type": "string", "format": "date-time" },
    "targets": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/target" } },
    "exclusions": { "type": "array", "items": { "$ref": "#/$defs/target" }, "default": [] },
    "allowedChecks": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "maxRequestsPerSecond": { "type": "integer", "minimum": 1, "maximum": 1000 },
    "maxConcurrency": { "type": "integer", "minimum": 1, "maximum": 128 },
    "destructiveAllowed": { "const": false },
    "authorizationReference": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "value"],
      "properties": {
        "type": { "enum": ["url", "host", "cidr", "path", "image", "cloud"] },
        "value": { "type": "string", "minLength": 1 }
      }
    }
  }
}
