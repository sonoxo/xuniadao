{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/sonoxo/xuniadao/ontology/civil-defense-simulation.schema.json",
  "title": "XUNIA Civil Defense Simulation Scenario",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scenarioId",
    "provider",
    "exerciseOnly",
    "timestamp",
    "hazardZones",
    "provenance"
  ],
  "properties": {
    "scenarioId": { "type": "string", "minLength": 1 },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "exerciseOnly": { "const": true },
    "timestamp": { "type": "string", "format": "date-time" },
    "exerciseArea": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": { "type": "string" },
        "latitude": { "type": "number", "minimum": -90, "maximum": 90 },
        "longitude": { "type": "number", "minimum": -180, "maximum": 180 }
      }
    },
    "scenarioClass": {
      "type": "string",
      "enum": [
        "preparedness-training",
        "medical-surge",
        "infrastructure-resilience",
        "shelter-planning",
        "evacuation-exercise",
        "recovery-planning"
      ]
    },
    "hazardZones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["effectCategory", "severityBand"],
        "properties": {
          "effectCategory": {
            "type": "string",
            "enum": ["blast", "thermal", "radiation", "fallout", "infrastructure-disruption", "medical-demand"]
          },
          "severityBand": {
            "type": "string",
            "enum": ["low", "moderate", "high", "severe"]
          },
          "providerGeometry": {
            "description": "Opaque provider-supplied geometry. XUNIA does not derive offensive parameters from it.",
            "type": ["object", "array", "string", "null"]
          },
          "uncertainty": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "assumptions"],
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "assumptions": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": "string" }
      }
    },
    "responseContext": {
      "type": "object",
      "additionalProperties": true,
      "description": "Emergency-management context such as shelter capacity, hospital surge, logistics, routes, utilities, and response teams."
    }
  },
  "not": {
    "anyOf": [
      { "required": ["targetRanking"] },
      { "required": ["optimalYield"] },
      { "required": ["optimalBurstHeight"] },
      { "required": ["casualtyMaximization"] },
      { "required": ["strikeSequence"] },
      { "required": ["weaponDesign"] }
    ]
  }
}
